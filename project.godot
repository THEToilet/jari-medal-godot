; Engine configuration file.
config_version=5

[application]

config/name="じゃりメダル ビル解体"
run/main_scene="res://scenes/main.tscn"
run/main_scene.virtual_cabinet="res://virtual/virtual_cabinet.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/image="res://assets/splash.png"
boot_splash/bg_color=Color(1, 0.839, 0.251, 1)
boot_splash/fullsize=true

[audio]

general/default_playback_type.web=1

[autoload]

MedalWallet="*res://scripts/medal_wallet.gd"
Sfx="*res://scripts/sfx.gd"
Fader="*res://scripts/fader.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=60
3d/solver/contact_max_allowed_penetration=0.0005

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.2, 0.66, 0.99, 1)
